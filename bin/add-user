#!/bin/bash
set -euo pipefail
read -p "Username: " u
read -p "Password: " p
read -p "Days: " d
[[ "$u" =~ ^[a-z_][a-z0-9_-]{2,31}$ ]] || { echo "Bad username"; exit 1; }
[[ "$d" =~ ^[0-9]+$ ]] || { echo "Bad days"; exit 1; }
EXP=$(date -d "+${d} days" +%Y-%m-%d)
useradd -M -s /bin/false -e "$EXP" "$u"
echo "$u:$p" | chpasswd
echo "[+] $u expires $EXP"
