#!/bin/bash
set -euo pipefail
ENV_FILE="/etc/telecom-engine.env"
if [ -f "$ENV_FILE" ] && grep -q "UUID=" "$ENV_FILE"; then
  echo "[*] Secrets already exist"; exit 0; fi
mkdir -p "$(dirname "$ENV_FILE")"
UUID=$(cat /proc/sys/kernel/random/uuid)
KEYPAIR=$(/usr/local/bin/xray x25519 2>/dev/null || echo "")
[ -z "$KEYPAIR" ] && { echo "Install xray first"; exit 1; }
PRIV=$(echo "$KEYPAIR" | grep "Private key:" | awk '{print $3}')
PUB=$(echo "$KEYPAIR" | grep "Public key:" | awk '{print $3}')
SID=$(openssl rand -hex 4)
HP=$(openssl rand -base64 32 | tr -d '=+/')
cat > "$ENV_FILE" <<E
DOMAIN="__DOMAIN__"
UUID="$UUID"
REALITY_PRIVKEY="$PRIV"
REALITY_PUBKEY="$PUB"
SHORT_ID="$SID"
HY2_PASS="$HP"
E
chmod 600 "$ENV_FILE"
echo "[*] Secrets generated"
