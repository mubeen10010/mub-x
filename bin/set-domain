#!/bin/bash
set -euo pipefail
read -p "Domain: " d
[ -z "$d" ] && exit 1
echo "$d" > /usr/local/etc/xray/domain
systemctl stop apache2 nginx haproxy 2>/dev/null || true
fuser -k 80/tcp 2>/dev/null || true
sleep 1
certbot certonly --standalone -d "$d" --agree-tos --register-unsafely-without-email --non-interactive
