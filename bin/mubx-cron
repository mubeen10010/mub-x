#!/usr/bin/env bash
curl -sL -o /usr/local/share/xray/geoip.dat https://github.com/v2fly/geoip/releases/latest/download/geoip.dat 2>/dev/null || true
curl -sL -o /usr/local/share/xray/geosite.dat https://github.com/v2fly/domain-list-community/releases/latest/download/dlc.dat 2>/dev/null || true
certbot renew --quiet --post-hook "systemctl reload nginx haproxy" 2>/dev/null || true
for svc in haproxy nginx xray dropbear squid; do
  systemctl is-active --quiet "$svc" || systemctl restart "$svc" 2>/dev/null || true
done
