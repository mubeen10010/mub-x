#!/usr/bin/env bash
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_AMBER='\033[38;5;214m'
C_ORANGE='\033[38;5;208m'
C_DIM='\033[38;5;242m'
C_WHITE='\033[38;5;255m'
C_GREEN='\033[38;5;48m'
C_RED='\033[38;5;196m'
C_YELLOW='\033[38;5;226m'
C_CYAN='\033[38;5;51m'

clear
echo -e "${C_AMBER}╔══════════════════════════════════════════════════════════════════╗${C_RESET}"
echo -e "${C_AMBER}║${C_RESET} ${C_BOLD}${C_ORANGE}MUB-X TACTICAL CARRIER BUG-HOST & SNI AUDITOR${C_RESET}                   ${C_AMBER}║${C_RESET}"
echo -e "${C_AMBER}╚══════════════════════════════════════════════════════════════════╝${C_RESET}"

TARGET="$1"
if [ -z "$TARGET" ]; then
    read -p " Enter candidate domain / bug-host to audit: " TARGET
fi
[ -z "$TARGET" ] && { echo -e "${C_RED}[!] No target specified.${C_RESET}"; exit 1; }

echo -e "\n${C_BOLD}[*] Auditing Target:${C_RESET} ${C_CYAN}${TARGET}${C_RESET}"
echo -e "${C_DIM}──────────────────────────────────────────────────────────────────${C_RESET}"

echo -ne " ${C_WHITE}1. DNS Resolution Check           :${C_RESET} "
RESOLVED_IP=$(dig +short "$TARGET" | grep -E '^[0-9.]+' | head -n 1)
if [ -n "$RESOLVED_IP" ]; then
    echo -e "${C_GREEN}[PASS]${C_RESET} Resolves to ${C_YELLOW}${RESOLVED_IP}${C_RESET}"
else
    echo -e "${C_RED}[FAIL] Host does not resolve.${C_RESET}"
fi

echo -ne " ${C_WHITE}2. HTTP Direct Response (Port 80) :${C_RESET} "
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 4 "http://${TARGET}")
if [ "$HTTP_CODE" == "200" ] || [ "$HTTP_CODE" == "301" ] || [ "$HTTP_CODE" == "302" ]; then
    echo -e "${C_GREEN}[PASS] HTTP ${HTTP_CODE}${C_RESET}"
else
    echo -e "${C_AMBER}[ALERT] HTTP ${HTTP_CODE}${C_RESET}"
fi

echo -ne " ${C_WHITE}3. TLS 1.3 Handshake & RTT Latency:${C_RESET} "
RTT=$(curl -s -o /dev/null -w "%{time_appconnect}s" --connect-timeout 5 "https://${TARGET}" 2>/dev/null)
if [ "$RTT" != "0.000s" ] && [ -n "$RTT" ]; then
    echo -e "${C_GREEN}[PASS] Handshake completed in ${C_YELLOW}${RTT}${C_RESET}"
else
    echo -e "${C_RED}[FAIL] TLS handshake timed out or was blocked.${C_RESET}"
fi

echo -ne " ${C_WHITE}4. Squid CONNECT Forwarding Test  :${C_RESET} "
SQUID_TEST=$(printf "CONNECT ${TARGET}:443 HTTP/1.1\r\nHost: ${TARGET}:443\r\n\r\n" | nc -w 4 127.0.0.1 8080 2>/dev/null | head -n 1)
if echo "$SQUID_TEST" | grep -q "200 Connection established"; then
    echo -e "${C_GREEN}[PASS] Handshake 200 via Squid :8080${C_RESET}"
else
    echo -e "${C_AMBER}[WARN] Non-200 response: ${SQUID_TEST:-Timed Out}${C_RESET}"
fi

echo -e "${C_DIM}──────────────────────────────────────────────────────────────────${C_RESET}"
echo -e " ${C_BOLD}Auditor Verdict:${C_RESET}"
if [ -n "$RESOLVED_IP" ] && [ "$RTT" != "0.000s" ]; then
    echo -e " ${C_GREEN}✔ Valid candidate for SNI injection and VLESS-WS routing.${C_RESET}\n"
else
    echo -e " ${C_RED}✖ High risk of carrier drops or captive portal redirection.${C_RESET}\n"
fi
